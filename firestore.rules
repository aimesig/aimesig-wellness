rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function sharePath(ownerId, friendId) {
      return /databases/$(database)/documents/sharePermissions/$(ownerId + "_" + friendId);
    }

    function hasShare(ownerId, friendId) {
      return exists(sharePath(ownerId, friendId));
    }

    function canViewRoutineData(ownerId) {
      return isOwner(ownerId)
        || (request.auth != null
          && hasShare(ownerId, request.auth.uid)
          && get(sharePath(ownerId, request.auth.uid)).data.friendId == request.auth.uid
          && get(sharePath(ownerId, request.auth.uid)).data.routineCalendar == true);
    }

    function canViewAnalytics(ownerId) {
      return isOwner(ownerId)
        || (request.auth != null
          && hasShare(ownerId, request.auth.uid)
          && get(sharePath(ownerId, request.auth.uid)).data.friendId == request.auth.uid
          && get(sharePath(ownerId, request.auth.uid)).data.analytics == true);
    }

    function canViewMedical(ownerId, reportId) {
      return isOwner(ownerId)
        || (request.auth != null
          && hasShare(ownerId, request.auth.uid)
          && get(sharePath(ownerId, request.auth.uid)).data.friendId == request.auth.uid
          && reportId in get(sharePath(ownerId, request.auth.uid)).data.medicalReportIds);
    }

    function canViewGeneralDocument(ownerId, documentId) {
      return isOwner(ownerId)
        || (request.auth != null
          && hasShare(ownerId, request.auth.uid)
          && get(sharePath(ownerId, request.auth.uid)).data.friendId == request.auth.uid
          && documentId in get(sharePath(ownerId, request.auth.uid)).data.generalDocumentIds);
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isOwner(userId);
    }

    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // One document per owner/friend pair. The owner controls permissions;
    // the friend can only read their own granted permissions.
    match /sharePermissions/{shareId} {
      // A get() for a share that has not been created yet has no
      // resource.data to evaluate. Allow authenticated point reads so
      // the owner can safely open the Share screen before saving.
      allow get: if request.auth != null;

      // List/query access is restricted to the friend receiving the share.
      allow list: if request.auth != null
        && resource.data.friendId == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.friendId != request.auth.uid
        && request.resource.data.routineCalendar is bool
        && request.resource.data.analytics is bool
        && request.resource.data.medicalReportIds is list
        && request.resource.data.generalDocumentIds is list;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (resource.data.receiverId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.status in ['accepted', 'declined'])
        ||
        (resource.data.senderId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.status == 'cancelled')
      );
      allow delete: if false;
    }

    match /users/{userId} {
      // Main user document remains private. Shared access is granted only
      // to the specific subcollections below.
      allow read, write: if isOwner(userId);

      match /routines/{routineId} {
        allow read: if canViewRoutineData(userId);
        allow write: if isOwner(userId);
      }

      match /routineLogs/{logId} {
        allow read: if canViewRoutineData(userId);
        allow write: if isOwner(userId);
      }

      match /analyticsCards/{cardId} {
        allow read: if canViewAnalytics(userId);
        allow write: if isOwner(userId);
      }

      match /healthCheckups/{reportId} {
        allow read: if canViewMedical(userId, reportId);
        allow write: if isOwner(userId);
      }

      match /medicalReports/{reportId} {
        allow read: if canViewMedical(userId, reportId);
        allow write: if isOwner(userId);
      }

      // Health issues are never shared through the social sharing system.
      match /healthIssues/{issueId} {
        allow read, write: if isOwner(userId);
      }

      match /profile/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /generalDocuments/{documentId} {
        allow read: if canViewGeneralDocument(userId, documentId);
        allow write: if isOwner(userId);
      }

      match /generalDocumentFolders/{folderId} {
        allow read, write: if isOwner(userId);
      }

      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == friendId
          && request.resource.data.requestId is string
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
          && (
            getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.senderId == userId
            || getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.receiverId == userId
          );
        allow update, delete: if isOwner(userId);
      }
    }
  }
}

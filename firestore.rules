rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /routines/{routineId} {
        allow read, write: if isOwner(userId);
      }

      match /routineLogs/{logId} {
        allow read, write: if isOwner(userId);
      }

      match /profile/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /analyticsCards/{cardId} {
        allow read, write: if isOwner(userId);
      }

      match /medicalReports/{reportId} {
        allow read, write: if isOwner(userId);
      }

      match /healthCheckups/{checkupId} {
        allow read, write: if isOwner(userId);
      }

      match /healthIssues/{issueId} {
        allow read, write: if isOwner(userId);
      }

      // General Documents
      match /generalDocuments/{documentId} {
        allow read, write: if isOwner(userId);
      }

      // General Document Folders
      match /generalDocumentFolders/{folderId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
